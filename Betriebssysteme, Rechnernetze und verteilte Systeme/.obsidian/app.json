{
  "legacyEditor": false,
  "livePreview": true,
  "defaultViewMode": "preview",
  "strictLineBreaks": false,
  "showLineNumber": true,
  "foldHeading": true,
  "foldIndent": true,
  "useTab": false,
  "tabSize": 2,
  "readableLineLength": true,
  "spellcheck": true,
  "spellcheckLanguages": [
    "de-DE"
  ],
  "vimMode": false,
  "promptDelete": true,
  "alwaysUpdateLinks": true,
  "newFileLocation": "current",
  "attachmentFolderPath": "assets",
  "pdfExportSettings": {
    "pageSize": "A4",
    "landscape": false,
    "margin": "0",
    "downscalePercent": 100
  }
}